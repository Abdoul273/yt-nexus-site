#!/usr/bin/env bash
# Publie les APK de YT-NEXUS mobile comme release GitHub (le site les affiche tout seul).
# Les notes (1er argument) s'affichent dans l'app, dans la fenêtre « Nouvelle version ».
#   ./publier "- Lecteur intégré\n- Suggestions de recherche"
set -euo pipefail
MOBILE="$HOME/Documents/MES_PROJETS/MES_APPLIS/YT-DOWNLOAD/mobile"
OUT="$MOBILE/build/app/outputs/flutter-apk"
VERSION=$(grep -oP '^version: \K[0-9.]+' "$MOBILE/pubspec.yaml")
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
for f in app-arm64-v8a-release.apk app-armeabi-v7a-release.apk; do
    [[ -f "$OUT/$f" ]] || { echo "Manque $OUT/$f : lance d'abord flutter build apk --release --split-per-abi" >&2; exit 1; }
    if [[ "$OUT/$f" -ot "$MOBILE/pubspec.yaml" ]]; then
        echo "Attention : $f est plus ancien que pubspec.yaml (APK pas reconstruit ?)" >&2
    fi
done
cp "$OUT/app-arm64-v8a-release.apk" "$TMP/yt-nexus.apk"
cp "$OUT/app-armeabi-v7a-release.apk" "$TMP/yt-nexus-armv7.apk"
gh release create "v$VERSION" -R Abdoul273/yt-nexus-site \
    --title "YT-NEXUS $VERSION" --notes "$(printf '%b' "${1:-YT-NEXUS $VERSION pour Android 10+.}")" \
    "$TMP/yt-nexus.apk" "$TMP/yt-nexus-armv7.apk"
echo "Publié : https://abdoul273.github.io/yt-nexus-site/"
